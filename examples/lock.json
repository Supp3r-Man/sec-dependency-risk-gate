{
  "lockfile_version": 1,
  "project": "sample-app",
  "direct": [
    "quartz-router",
    "lumen-cache",
    "amber-parser",
    "quartz-routr"
  ],
  "packages": {
    "quartz-router": {
      "version": "1.9.0",
      "depth": 1,
      "requires": [
        "nectar-codec"
      ],
      "license": "MIT"
    },
    "nectar-codec": {
      "version": "1.10",
      "depth": 2,
      "requires": [
        "pebble-schema"
      ],
      "license": "Apache-2.0"
    },
    "pebble-schema": {
      "version": "2.0.0",
      "depth": 3,
      "license": "AGPL-3.0-only"
    },
    "lumen-cache": {
      "version": "2.1",
      "depth": 1,
      "license": "MIT"
    },
    "amber-parser": {
      "version": "1.0.3",
      "depth": 1
    },
    "quartz-routr": {
      "version": "0.1",
      "depth": 1,
      "license": "MIT"
    }
  }
